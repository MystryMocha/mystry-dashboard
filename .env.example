# Panel listen address (this machine only by default)
HOST=127.0.0.1
PORT=3000

# Runtime directory overrides. Usually left empty for source development; the portable entry sets them explicitly to directories inside the package.
MYSTRY_HOME=
MYSTRY_CONFIG_PATH=
MYSTRY_DATA_DIR=
# The process fingerprint is injected by mdash; usually left empty for manual development
MYSTRY_PROCESS_FINGERPRINT=

# When starting manually, JWT_SECRET, SETUP_TOKEN and LAUNCHER_TOKEN should use three different
# 64-digit hex random values. mdash generates them automatically; to generate manually, run this three times:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SETUP_TOKEN=
# Only for the local mdash to stop the panel safely; use another, different 64-digit hex random value.
LAUNCHER_TOKEN=

# Exact CORS origin whitelist, comma-separated; do not enter *
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Request rate limiting; sign-in counts only password verification failures, and a successful sign-in clears the failure count.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=300000

# HTTP request, connection, upload and file download lifetimes (milliseconds)
HTTP_REQUEST_TIMEOUT_MS=900000
HTTP_CONNECTION_TIMEOUT_MS=300000
HTTP_KEEP_ALIVE_TIMEOUT_MS=72000
UPLOAD_IDLE_TIMEOUT_MS=30000
FILE_DOWNLOAD_IDLE_TIMEOUT_MS=60000

# Console ticket lifetime (seconds); each ticket can establish only one WS connection
CONSOLE_TICKET_TTL_SECONDS=60

# File download ticket lifetime (seconds); each ticket can download only once
FILE_DOWNLOAD_TICKET_TTL_SECONDS=60

# JSON, concurrency and task limits
MAX_JSON_BODY_BYTES=1048576
MAX_CONCURRENT_UPLOADS=1
MAX_CONCURRENT_FILE_DOWNLOADS=4
MAX_CONCURRENT_TASKS=1
MAX_QUEUED_TASKS=2
TASK_TIMEOUT_MS=1800000
# Backup and restore task timeout, 6 hours by default
BACKUP_TASK_TIMEOUT_MS=21600000
# ZIP two-phase import preview: valid for 30 minutes by default, with at most 2 kept globally
IMPORT_PREVIEW_TTL_SECONDS=1800
MAX_IMPORT_PREVIEWS=2

# Core download and installer limits
MAX_CORE_DOWNLOAD_BYTES=536870912
CORE_DOWNLOAD_TIMEOUT_MS=300000
MAX_CORE_METADATA_BYTES=2097152
CORE_METADATA_TIMEOUT_MS=15000
MAX_INSTALLER_OUTPUT_BYTES=65536
INSTALLER_KILL_GRACE_MS=5000

# Text, command and console buffer limits
MAX_TEXT_FILE_BYTES=1048576
MAX_COMMAND_BYTES=4096
MAX_CONSOLE_BUFFER_BYTES=1048576
MAX_CONSOLE_CHUNK_BYTES=65536
MAX_CONSOLE_INCOMING_BYTES=4352
MAX_CONSOLE_CONNECTIONS=20
MAX_CONSOLE_COMMANDS_PER_WINDOW=60
CONSOLE_COMMAND_WINDOW_MS=60000
MAX_CONSOLE_STDIN_BYTES=65536

# Upload and ZIP extraction quotas
MAX_UPLOAD_BYTES=536870912
# Backup upload (.tar.gz) limit, 10 GiB by default
MAX_BACKUP_UPLOAD_BYTES=10737418240
MAX_ZIP_ENTRIES=10000
MAX_ZIP_ENTRY_BYTES=1073741824
MAX_ZIP_UNCOMPRESSED_BYTES=2147483648
MAX_ZIP_CENTRAL_DIRECTORY_BYTES=33554432

# Quotas for the same-machine directory handoff in DATA_DIR/imports (the source directory is read-only and copied into a managed instance)
MAX_EXISTING_IMPORT_ENTRIES=200000
MAX_EXISTING_IMPORT_BYTES=107374182400

# ModLoader args scan budgets (list precheck vs. import/deploy deep scan)
MOD_LOADER_PRECHECK_MAX_DEPTH=4
MOD_LOADER_PRECHECK_MAX_ENTRIES=200
MOD_LOADER_PRECHECK_TIMEOUT_MS=250
MOD_LOADER_SCAN_MAX_DEPTH=64
MOD_LOADER_SCAN_MAX_ENTRIES=50000
MOD_LOADER_SCAN_TIMEOUT_MS=30000

# Data directory (a path relative to the project root, or an absolute path); instances can only live in DATA_DIR/instances/<id>
DATA_DIR=data
# Backup directory; DATA_DIR/backups when empty. It may point to another disk, but must not be inside instances, imports, uploads or .mystry-staging
BACKUP_DIR=
