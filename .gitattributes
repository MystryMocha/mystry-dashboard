# Use LF line endings everywhere, to avoid whole-file noise diffs between Windows and Linux
* text=auto eol=lf

# Windows batch files must be CRLF: when cmd.exe reads a batch file with LF endings, jump labels and multi-byte characters may be misaligned,
# and half a line gets executed as a command. They are still stored as LF in the repo and converted to CRLF only on checkout to the working tree.
*.cmd text eol=crlf
*.bat text eol=crlf

# No line ending conversion for binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.db binary
